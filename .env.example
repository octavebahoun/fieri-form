# Firebase client (public — OK dans le navigateur)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fieri-form-insti.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fieri-form-insti
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fieri-form-insti.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Serveur uniquement (ne jamais préfixer NEXT_PUBLIC_)
# JSON brut du compte de service OU la même chose encodée en base64
FIREBASE_SERVICE_ACCOUNT=

# Code d'accès pour /admin (cookie httpOnly)
ADMIN_PASSCODE=

# Optionnel : secret dédié pour signer le cookie admin
# ADMIN_COOKIE_SECRET=

# Démo locale uniquement : données factices sur /admin
# USE_MOCK_DATA=true
